<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 3: the evening reminder and the cash-count reminder (no network, no exact alarms). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Phase 5: Google Drive backup (the only network use) and the fingerprint app lock. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".AdamApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdamPay"
        tools:targetApi="36">

        <!-- The launcher entry is a tiny router (same pattern as Hyper Athlete). The Honor AI Button lists one
             entry per package; in phase 6 the router learns that button's double press and opens Quick Log.
             Keeping this component name from day one means home-screen icons never break. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.AdamPay.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Phase 6: app shortcuts (long press on the icon). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AdamPay.Splash"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- Small sheet over any app: pick the category of an amount logged from the notification. -->
        <activity
            android:name=".core.reminders.QuickCategoryActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AdamPay.Translucent" />

        <!-- Phase 6: Quick Log, the add sheet over any app (widgets, shortcuts, AI Button double press). -->
        <activity
            android:name=".ui.quicklog.QuickLogActivity"
            android:exported="false"
            android:taskAffinity="com.adampay.app.quicklog"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AdamPay.Translucent" />

        <!-- Reminder alarms and notification actions (only this app sends them). -->
        <receiver android:name=".core.reminders.ReminderReceiver" android:exported="false" />

        <!-- System broadcasts that clear alarms: re-arm the reminders. -->
        <receiver android:name=".core.reminders.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Phase 6: home-screen widgets (Glance). -->
        <receiver
            android:name=".ui.widgets.BalanceWidgetReceiver"
            android:exported="true"
            android:label="@string/w_name_balance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_balance" />
        </receiver>
        <receiver
            android:name=".ui.widgets.QuickWidgetReceiver"
            android:exported="true"
            android:label="@string/w_name_quick">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick" />
        </receiver>
        <receiver
            android:name=".ui.widgets.GoalWidgetReceiver"
            android:exported="true"
            android:label="@string/w_name_goal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_goal" />
        </receiver>

        <!-- WorkManager is initialised by AdamApp (Hilt worker factory). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
