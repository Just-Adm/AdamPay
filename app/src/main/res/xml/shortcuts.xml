<?xml version="1.0" encoding="utf-8"?>
<!-- Long press on the app icon. They open the launcher router (MainActivity), which sends them on. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="expense"
        android:enabled="true"
        android:icon="@drawable/sc_expense"
        android:shortcutShortLabel="@string/sc_expense"
        android:shortcutLongLabel="@string/sc_expense_long">
        <intent
            android:action="com.adampay.app.action.NEW_EXPENSE"
            android:targetPackage="com.adampay.app"
            android:targetClass="com.adampay.app.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="income"
        android:enabled="true"
        android:icon="@drawable/sc_income"
        android:shortcutShortLabel="@string/sc_income"
        android:shortcutLongLabel="@string/sc_income_long">
        <intent
            android:action="com.adampay.app.action.NEW_INCOME"
            android:targetPackage="com.adampay.app"
            android:targetClass="com.adampay.app.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="count"
        android:enabled="true"
        android:icon="@drawable/sc_count"
        android:shortcutShortLabel="@string/sc_count"
        android:shortcutLongLabel="@string/sc_count_long">
        <intent
            android:action="com.adampay.app.action.COUNT_CASH"
            android:targetPackage="com.adampay.app"
            android:targetClass="com.adampay.app.MainActivity" />
    </shortcut>
</shortcuts>
